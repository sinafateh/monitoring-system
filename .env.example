NODE_ENV=production
PORT=3001
WORKSPACE_KEY=monitoring-system

# Required to manage ESP8266 devices from the Talk page. Use a unique random
# password with at least 24 characters and keep it out of source control.
ESP_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_24_CHARACTERS

# PostgreSQL connection. Prefer DATABASE_URL in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional separate connection fields for a local/VPS PostgreSQL instance.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=monitoring_system
# PGUSER=postgres
# PGPASSWORD=CHANGE_ME
# PGSSL=false

# Optional comma-separated origins when the API is hosted separately.
# CORS_ORIGIN=https://your-domain.ir
