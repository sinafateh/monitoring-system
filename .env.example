API_PORT=3001
WORKSPACE_KEY=monitoring-system

# Local PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=monitoring_system
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD

# You can use DATABASE_URL instead, but remove the variables above if you do.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/monitoring_system
